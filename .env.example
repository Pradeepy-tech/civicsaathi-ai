# GEMINI_API_KEY: Required for server-side Gemini AI classification and voice transcription.
# AI Studio automatically injects this at runtime from user secrets (Settings > Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ASK_SAATHI_API_KEY: Optional dedicated server-side Gemini API key for AskSaathi chatbot responses (falls back to GEMINI_API_KEY).
ASK_SAATHI_API_KEY="MY_GEMINI_API_KEY"

# SPEECH_TO_TEXT_API_KEY: Optional dedicated Speech-to-Text API key (supports VachaAI vach_... or Gemini API keys; falls back to GEMINI_API_KEY).
SPEECH_TO_TEXT_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# PIN_HASH_SALT: Optional custom salt used when hashing 4-digit citizen complaint PINs.
PIN_HASH_SALT="civicsaathi-prototype-salt"

# SUPER_ADMIN_EMAIL: Optional email automatically granted Municipal Super Admin privileges on Google Sign-In.
SUPER_ADMIN_EMAIL="admin@example.org"

# Cloud SQL (PostgreSQL) connection parameters injected automatically by the platform:
SQL_HOST="/cloudsql/project:region:instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password_placeholder"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password_placeholder"
